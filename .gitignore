# impeccable 工具的本地缓存/配置（config.json、hook.cache.json），任意层级，不入库
.impeccable/

# 由 site/build.js 在每次 Vercel 部署时生成（buildCommand）——不提交，
# 以免漂移或丢 URL。每次从 PHASES 重新生成。
site/sitemap.xml
site/llms.txt
# 由 build.js 每次部署写入，记录本次部署的 git 分支（供 lesson.html 按分支拉取 docs）
site/build-meta.js
# 认证课程数据也由 build.js 在部署时生成，不提交。
site/certification-data.js
site/figure-manifest.js
site/lesson-seo.json
site/certification-seo.json
site/langs.js
# 部署构建生成的中文 API 内容快照与页面 Markdown。
generated/
site/agent-pages/
# 预渲染静态课程页（writeLessonPages 生成，523 个 index.html）——同款策略不提交
site/lessons/
# 预渲染项目页（writeProjectPages 生成）——同款策略不提交
site/project/

# scripts/build_catalog.py 的可再生产物；中文仓的发布与课数真相仍由
# site/build.js 管理，因此忽略 catalog.json，避免误提交生成文件。
catalog.json
book/_build/
i18n/*/phases/
i18n/*/.cache/
i18n/*/.translate-cache.json
i18n/*/ui.json

# 项目、手册、Hub 与动态 OG 数据由主构建从中文源生成。
site/projects-data.js
site/project-content/
site/manual-*.html
site/manuals.html
site/manuals-data.js
site/hubs/
site/lesson-terms.json
site/og-cards.json

site/hub-pages.json

