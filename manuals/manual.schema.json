{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieng-zh.cn/manuals/manual.schema.json",
  "title": "手册清单",
  "description": "manuals/<id>/ 下单本手册的 manual.json。site/build-manuals.js 在每次构建时校验这些规则。",
  "type": "object",
  "required": ["id", "title", "subtitle", "summary", "audience", "edition", "status", "pin", "outcomes", "palette", "sources", "parts"],
  "additionalProperties": false,
  "$defs": {
    "hue": { "enum": ["grey", "blue", "teal", "violet", "green", "amber", "plum", "olive", "indigo", "rose"] },
    "doc": { "type": "string", "pattern": "^[a-z0-9/._-]+\\.md$" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
    "status": { "enum": ["draft", "ready"] },
    "pin": {
      "type": "object",
      "required": ["subject", "version", "source", "commit", "date", "verified"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https://\\S+$" },
        "commit": { "type": "string", "minLength": 7 },
        "date": { "$ref": "#/$defs/date" },
        "verified": { "$ref": "#/$defs/date" }
      }
    },
    "outcomes": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "palette": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["hue", "meaning"],
        "additionalProperties": false,
        "properties": { "hue": { "$ref": "#/$defs/hue" }, "meaning": { "type": "string", "minLength": 1 } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "usedFor"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "usedFor": { "type": "string" } }
      }
    },
    "quoteSources": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }, "additionalProperties": { "type": ["string", "null"] }, "description": "来源标记所用的键及对应的随仓库保存文件。null 表示没有随仓库保存的文件。每个来源标记和 rule 块都必须使用已声明的键。" },
    "capture": {
      "type": "object",
      "required": ["run", "check"],
      "additionalProperties": false,
      "properties": { "run": { "$ref": "#/$defs/argv" }, "check": { "$ref": "#/$defs/argv" }, "timeoutSeconds": { "type": "integer", "minimum": 1, "description": "审计允许 capture.check 运行的秒数，默认 300。" } }
    },
    "front": { "$ref": "#/$defs/doc" },
    "plate": {
      "type": "object",
      "required": ["figure", "title", "caption"],
      "additionalProperties": false,
      "properties": { "figure": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "title": { "type": "string", "minLength": 1 }, "caption": { "type": "string", "minLength": 1 } }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "thesis", "accent", "sections"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "thesis": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "accent": { "$ref": "#/$defs/hue" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "file"],
              "additionalProperties": false,
              "properties": { "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" }, "file": { "$ref": "#/$defs/doc" } }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "thesis": { "type": "string" },
        "summary": { "type": "string" },
        "accent": { "$ref": "#/$defs/hue" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "file"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string", "pattern": "^R\\.\\d+$" }, "file": { "$ref": "#/$defs/doc" } }
          }
        }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
