{
  "id": "mcpa-f",
  "slug": "mcpa-f",
  "examCode": "MCPA",
  "credential": "Model Context Protocol Associate",
  "shortName": "MCP Associate",
  "level": "基础",
  "accent": "blue",
  "badge": {
    "imageUrl": "https://training.linuxfoundation.org/wp-content/uploads/2026/06/MCPA_Badge-1.png",
    "width": 300,
    "height": 300,
    "shape": "square"
  },
  "summary": "证明你理解 Model Context Protocol 的工作方式：宿主、客户端、服务端与工具，连接它们的消息流和原语，以及保障连接安全的信任边界。",
  "audience": "面向需要把 agent 连接到外部系统，并理解协议工作方式及组件通信机制的 AI 工程师、平台工程师和 AI 治理专业人员。",
  "recommendedExperience": [
    "具备 JSON-RPC 或类似消息协议的基础知识",
    "有调用 OpenAI、Anthropic 或本地模型等 LLM API 的经验",
    "理解工具使用和“思考—行动—观察”循环等 agent 模式",
    "具备 API key、OAuth 2.1、token 处理和认证标头等基础安全知识",
    "能够阅读 MCP 服务端 manifest 及其能力定义"
  ],
  "exam": {
    "items": 60,
    "timeLimitMinutes": 90,
    "feeUsd": 250,
    "validityMonths": 24,
    "eligibilityMonths": 12,
    "retakes": 1,
    "level": "入门",
    "specVersion": "2026-07-28",
    "itemCountPublished": false,
    "passingScorePublished": false,
    "format": "选择题",
    "delivery": "在线监考",
    "effective": "2026 年 9 月",
    "officialGuideUrl": "https://training.linuxfoundation.org/certification/model-context-protocol-associate-mcpa/"
  },
  "domains": [
    {
      "id": "mcp-fundamentals",
      "name": "MCP 基础",
      "weight": 16,
      "objectives": [
        "解释 MCP 的目的与范围，以及它在 AI 应用和外部系统之间标准化的集成问题",
        "描述 MCP 的核心概念：宿主、客户端、服务端、原语和无状态 JSON-RPC 请求模型",
        "分析互操作性、协议版本控制，以及开放协议相较于按系统定制集成的价值",
        "阅读 MCP 规范、版本历史和功能生命周期，区分当前、已弃用和已移除的行为"
      ]
    },
    {
      "id": "architecture-and-components",
      "name": "架构与组件",
      "weight": 14,
      "objectives": [
        "阅读定义 MCP 消息、工具定义、能力和服务端 manifest 的 schema 与结构化数据",
        "区分 MCP 宿主、客户端和服务端的职责，以及发现与能力协商如何连接它们",
        "追踪从用户请求经宿主、模型、客户端、服务端，再回到模型上下文的交互流"
      ]
    },
    {
      "id": "interactions-and-execution",
      "name": "交互与执行",
      "weight": 26,
      "objectives": [
        "应用请求、通知、订阅和多轮交互模式，并处理每种结果类型",
        "处理协议错误和工具执行错误，包括版本、能力、标头和验证失败",
        "梳理工具调用从发现、选择、调用、用户输入、进度、取消到结果的生命周期",
        "识别协议原语和实用机制，包括工具、资源、prompt、补全、缓存、分页、传输和已弃用客户端功能"
      ]
    },
    {
      "id": "security-and-governance",
      "name": "安全与治理",
      "weight": 24,
      "objectives": [
        "定位宿主、客户端、服务端、模型以及服务端所暴露工具和内容之间的信任边界",
        "应用基于 OAuth 的授权、客户端注册、scope 和用户同意，让用户批准服务端可查看和执行的内容",
        "选择针对工具投毒、注入、token 滥用和过宽访问的风险与安全控制",
        "设计可审计性和可观测性，让协议活动可追踪、可归因、可复核"
      ]
    },
    {
      "id": "use-cases-and-ecosystem",
      "name": "使用场景与生态",
      "weight": 20,
      "objectives": [
        "梳理构建和部署 MCP 的团队角色、职责、治理与采用模式",
        "为不同运维场景选择合适的原语或扩展",
        "分析客户端、服务端、SDK、扩展、网关和注册表之间的生态可移植性"
      ]
    }
  ],
