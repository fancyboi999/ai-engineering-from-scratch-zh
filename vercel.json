{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "site",
  "framework": null,
  "installCommand": "echo skip",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 10,
      "includeFiles": "generated/agent-content.json"
    },
    "api/v1/catalog.js": {
      "maxDuration": 10,
      "includeFiles": "generated/agent-content.json"
    },
    "api/v1/resource.js": {
      "maxDuration": 10,
      "includeFiles": "generated/agent-content.json"
    },
    "api/markdown.js": {
      "maxDuration": 10,
      "includeFiles": "{site/*.html,site/agent-pages/*.md}",
      "excludeFiles": "{site/**/*.js,site/{lessons,project-content,hubs,assets,figures}/**,site/*.{css,png,jpg,gif,svg,ico,xml}}"
    },
    "api/v1/markdown.js": {
      "maxDuration": 10,
      "includeFiles": "{site/*.html,site/agent-pages/*.md}",
      "excludeFiles": "{site/**/*.js,site/{lessons,project-content,hubs,assets,figures}/**,site/*.{css,png,jpg,gif,svg,ico,xml}}"
    },
    "api/not-found.js": {
      "maxDuration": 10,
      "includeFiles": "site/404.html"
    },
    "api/lesson.js": {
      "maxDuration": 10,
      "includeFiles": "{site/lesson.html,site/lesson-seo.json,site/lesson-terms.json,site/figure-manifest.js,site/lesson-markdown.js,site/md-render.js,phases/**/docs/zh.md,certifications/*/lessons/*/docs/zh.md,lib/og-fonts/*.json,lib/og-render.js}"
    },
    "api/certification.js": {
      "maxDuration": 10,
      "includeFiles": "{site/certification.html,site/certification-seo.json,lib/og-fonts/*.json,lib/og-render.js}"
    },
    "api/og.js": {
      "maxDuration": 10,
      "includeFiles": "{site/og-cards.json,site/lesson-seo.json,site/certification-seo.json,lib/og-fonts/*.json}",
      "excludeFiles": "{phases/**,projects/**,manuals/**,certifications/**,site/{lessons,project-content,hubs,agent-pages,assets,figures}/**,site/*.{html,js,css,png,jpg,gif,svg,ico,txt,md,xml}}"
    }
  },
  "routes": [
    {
      "src": "/og/([a-z]+)/([a-z0-9][a-z0-9/-]*)\\.png",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/api/og?type=$1&id=$2"
    },
    {
      "src": "/lessons/([a-z0-9-]+)/([a-z0-9-]+)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "dest": "/api/lesson?path=phases/$1/$2"
    },
    {
      "src": "/phase/([a-z0-9]+(?:-[a-z0-9]+)*)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "dest": "/agent-pages/phase/$1.md"
    },
    {
      "src": "/phase/([a-z0-9]+(?:-[a-z0-9]+)*)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/hubs/phase/$1.html"
    },
    {
      "src": "/glossary/([a-z0-9]+(?:-[a-z0-9]+)*)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "dest": "/agent-pages/glossary/$1.md"
    },
    {
      "src": "/glossary/([a-z0-9]+(?:-[a-z0-9]+)*)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/hubs/glossary/$1.html"
    },
    {
      "src": "/",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/api/markdown?path=/"
    },
    {
      "src": "/(index|about|catalog|glossary|prereqs|developer|contact|privacy|learning-paths|certifications)\\.html",
      "methods": [
        "GET",
        "HEAD"
      ],
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "dest": "/api/markdown?path=/$1.html"
    }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/project",
      "destination": "/project.html"
    },
    {
      "source": "/manuals",
      "destination": "/manuals.html"
    },
    {
      "source": "/manual-:id",
      "destination": "/manual-:id.html"
    },
    {
      "source": "/lesson",
      "destination": "/api/lesson"
    },
    {
      "source": "/certification",
      "destination": "/api/certification"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/about"
    },
    {
      "source": "/catalog",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/catalog"
    },
    {
      "source": "/glossary",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/glossary"
    },
    {
      "source": "/path",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/path"
    },
    {
      "source": "/roadmap",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/roadmap"
    },
    {
      "source": "/developer",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/developer"
    },
    {
      "source": "/docs",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/docs"
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/contact"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*"
        }
      ],
      "destination": "/api/markdown?path=/privacy"
    },
    {
      "source": "/glossary",
      "destination": "/glossary.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog.html"
    },
    {
      "source": "/certifications",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "destination": "/api/markdown?path=/certifications"
    },
    {
      "source": "/certifications",
      "destination": "/certifications.html"
    },
    {
      "source": "/assessment",
      "destination": "/assessment.html"
    },
    {
      "source": "/path",
      "destination": "/prereqs.html"
    },
    {
      "source": "/roadmap",
      "destination": "/prereqs.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/learning-paths",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "destination": "/api/markdown?path=/learning-paths"
    },
    {
      "source": "/learning-paths",
      "destination": "/learning-paths.html"
    },
    {
      "source": "/developer",
      "destination": "/developer.html"
    },
    {
      "source": "/docs",
      "destination": "/developer.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "/server.json"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/api/:missing*",
      "destination": "/api/not-found?api=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|webp|woff2|woff|ttf|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/certification-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/build-meta.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(glossary|catalog|certifications|certification|assessment|path|roadmap|about|learning-paths|developer|docs|contact|privacy)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/lessons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Content-Language",
          "value": "zh-CN"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/videos.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(phase|glossary)/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Content-Language",
          "value": "zh-CN"
        }
      ]
    },
    {
      "source": "/agent-pages/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Content-Language",
          "value": "zh-CN"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hubs/:kind(phase|glossary)/:slug.html",
      "destination": "/:kind/:slug",
      "permanent": true
    }
  ]
}
