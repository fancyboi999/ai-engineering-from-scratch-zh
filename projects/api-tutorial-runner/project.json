{
  "id": "api-tutorial-runner",
  "title": "API 教程运行器",
  "tagline": "检查 API 教程从第一个请求到最终结果是否仍能运行。",
  "summary": "帮助文档作者验证一连串 HTTP 示例。解析显式请求块，只替换先前响应中已声明的变量，并针对本地 fixture 或明确选择的测试端点运行。生成关联源文档的报告，暴露过时示例，让助手提出需审核的修正建议。",
  "level": 2,
  "languages": [
    "TypeScript"
  ],
  "source": "core",
  "prerequisiteProjects": [
    "json-schema-output-guard"
  ],
  "status": "ready",
  "hours": 8,
  "youWillBuild": "可重放请求清单、JUnit 结果和带注解的教程 HTML",
  "author": {
    "name": "AI Engineering from Scratch",
    "github": "rohitg00"
  },
  "languageWhy": {
    "TypeScript": "带类型的本地转换和可移植浏览器界面用 Node 标准库运行。"
  },
  "figures": true,
  "overviewFigure": "pj-api-tutorial-runner-1",
  "demo": {
