      "hours": 2,
      "difficulty": "core",
      "language": "typescript",
      "timeout": 60,
      "figure": "pj-api-tutorial-runner-2",
      "concepts": [
        "跨步骤解析带类型的变量"
      ]
    },
    {
      "id": "03-bounded-http",
      "title": "针对测试服务运行有界请求",
