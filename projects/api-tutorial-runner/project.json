      "hours": 2,
      "difficulty": "core",
      "language": "typescript",
      "timeout": 60,
      "figure": "pj-api-tutorial-runner-3",
      "concepts": [
        "针对测试服务运行有界请求"
      ]
    },
    {
      "id": "04-source-linked-report",
      "title": "导出关联源文档的失败与修正建议",
